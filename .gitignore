# Python cache and bytecode
__pycache__/
*.py[cod]
*$py.class

# Editor and OS files
.DS_Store
.idea/
.vscode/
*.swp
*.swo

# Training outputs and checkpoints
work_dirs/*
!work_dirs/.gitkeep
outputs/
checkpoints/
.dist_test/*
!.dist_test/.gitkeep
*.pth
*.pt
*.ckpt
*.onnx

# Logs and tensorboard artifacts
*.log
*.log.json
events.out.tfevents*
tf_logs/

# Local datasets and raw data
data/*
!data/.gitkeep
!data/README.md

# Test and coverage caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

